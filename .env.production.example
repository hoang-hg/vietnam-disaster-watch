# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_USER=disaster_admin
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=disaster_watch

# Security - CRITICAL: Generate a strong random string
# Use: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_LONG_RANDOM_STRING_FOR_JWT_TOKENS

# Frontend Configuration
# Leave VITE_API_BASE empty for Docker deployment
# API endpoints in code already include /api prefix (e.g., "/api/events")
# Nginx will proxy /api requests to backend:8000
VITE_API_BASE=

# Proxy Configuration (Optional)
# Uncomment if you need to use proxies for crawling
# CRAWLER_PROXIES='["http://proxy1:port","http://proxy2:port"]'

# Caching (Recommended for Production)
REDIS_URL=redis://redis:6379/0

# Application Settings
APP_TIMEZONE=Asia/Ho_Chi_Minh
PYTHONUNBUFFERED=1

# Domain Configuration (for SSL)
# Replace with your actual domain
DOMAIN=example.com
