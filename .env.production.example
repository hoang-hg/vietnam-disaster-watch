# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your actual values

# Database Configuration
# These are used to build the DB URL in docker-compose.prod.yml
DB_USER=disaster_admin
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=disaster_watch

# Use: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_LONG_RANDOM_STRING_FOR_JWT_TOKENS

# Default password for auto-seeded admin accounts
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_ADMIN_PASSWORD

# Frontend Configuration
# Leave VITE_API_BASE empty for standard Docker deployment using Nginx proxy.
# This ensures same-origin relative paths are used.
VITE_API_BASE=

# Optional: Override full DB URL (if DB is hosted outside Docker)
# APP_DB_URL=postgresql://user:pass@remotehost:5432/dbname

# Proxy Configuration (Optional)
# List of proxies for the crawler to rotate through
# CRAWLER_PROXIES='["http://proxy1:port","http://proxy2:port"]'

# Caching
REDIS_URL=redis://redis:6379/0

# Application Settings
APP_TIMEZONE=Asia/Ho_Chi_Minh
PYTHONUNBUFFERED=1

# Domain Configuration (for SSL via Certbot)
# Replace with your actual domain
DOMAIN=example.com
EMAIL=admin@example.com # For certbot registration
